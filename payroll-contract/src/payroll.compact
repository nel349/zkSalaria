// ========================================
// SELECTIVE DISCLOSURE CIRCUITS
// ========================================

// Grant income disclosure to lender/verifier
// Employee grants permission for lender to verify income using ZKML
// NOTE: Actual verification happens OFF-CHAIN with ZK proofs (EZKL)
// This circuit just stores the authorization on ledger
export circuit grant_income_disclosure(
  employee_id: Bytes<32>,
  lender_id: Bytes<32>,
  min_threshold: Uint<64>,
  expires_in: Uint<32>  // 0 = never expires, >0 = seconds until expiration
): [] {
  // Verify employee exists on public ledger
  assert(employee_accounts.member(disclose(employee_id)), "Employee not found");

  // Generate unique disclosure ID
  const permission_type = PC_PERMISSION_TYPE_INCOME_RANGE();
  const disclosure_id = PC_generate_disclosure_id(
    disclose(employee_id),
    disclose(lender_id),
    permission_type
  );

  // Generate shared encryption key (stored on ledger for both parties)
  const shared_key = PC_generate_shared_disclosure_key(
    disclose(employee_id),
    disclose(lender_id),
    permission_type
  );

  // Calculate expiration timestamp (disclose expires_in as it's not sensitive)
  const expiration = (disclose(expires_in) == 0 as Uint<32>) ?
    0 as Uint<32> :
    (current_timestamp + disclose(expires_in)) as Uint<32>;

  // Create disclosure authorization
  const authorization = PC_DisclosureAuthorization {
    grantor_id: disclose(employee_id),
    grantee_id: disclose(lender_id),
    shared_encryption_key: shared_key,
    threshold: disclose(min_threshold),
    created_at: current_timestamp,
    last_updated: current_timestamp,
    permission_type: permission_type,
    expires_at: expiration
  };

  // Store authorization on public ledger
  disclosure_authorizations.insert(disclosure_id, authorization);

  // Read employee payment history from ledger
  const payment_history = employee_payment_history.lookup(disclose(employee_id));

  // Encrypt payment history with shared key for grantee access
  const history_hash = persistentHash<Vector<2, Bytes<32>>>([
    persistentHash<Vector<12, PC_PaymentRecord>>(payment_history),
    shared_key
  ]);

  // Store shared encrypted history on ledger
  shared_payment_history.insert(disclosure_id, history_hash);
}

// Grant employment disclosure to verifier (landlord, background check, etc.)
// Stores authorization for verifier to verify employment status using ZKML
// NOTE: Actual verification happens OFF-CHAIN with ZK proofs (EZKL)
// NOTE: Employee grants disclosure for THIS contract's company (company_id from ledger)
export circuit grant_employment_disclosure(
  employee_id: Bytes<32>,
  verifier_id: Bytes<32>,
  expires_in: Uint<32>
): [] {
  // Verify employee exists
  assert(employee_accounts.member(disclose(employee_id)), "Employee not found");

  // Generate unique disclosure ID
  const permission_type = PC_PERMISSION_TYPE_EMPLOYMENT();
  const disclosure_id = PC_generate_disclosure_id(
    disclose(employee_id),
    disclose(verifier_id),
    permission_type
  );

  // Generate shared encryption key
  const shared_key = PC_generate_shared_disclosure_key(
    disclose(employee_id),
    disclose(verifier_id),
    permission_type
  );

  // Calculate expiration timestamp
  const expiration = (disclose(expires_in) == 0 as Uint<32>) ?
    0 as Uint<32> :
    (current_timestamp + disclose(expires_in)) as Uint<32>;

  // Create authorization (company_id stored separately if needed)
  const authorization = PC_DisclosureAuthorization {
    grantor_id: disclose(employee_id),
    grantee_id: disclose(verifier_id),
    shared_encryption_key: shared_key,
    threshold: 0 as Uint<64>,  // Not used for employment disclosures
    created_at: current_timestamp,
    last_updated: current_timestamp,
    permission_type: permission_type,
    expires_at: expiration
  };

  // Store authorization on public ledger
  disclosure_authorizations.insert(disclosure_id, authorization);
}

// Grant audit disclosure to auditor (compliance checks, pay equity analysis)
// Stores authorization for auditor to access THIS company's payroll data using ZKML
// NOTE: Actual analysis happens OFF-CHAIN with ZKML proofs (python/ezkl)
// NOTE: Caller must provide company_id and it must match this contract's company_id
export circuit grant_audit_disclosure(
  company_id_param: Bytes<32>,  // Must match this contract's company_id
  auditor_id: Bytes<32>,
  expires_in: Uint<32>
): [] {
  // Verify the provided company_id matches this contract's company_id
  assert(company_id_param == company_id, "Invalid company ID");

  // Generate unique disclosure ID
  const permission_type = PC_PERMISSION_TYPE_AUDIT();
  const disclosure_id = PC_generate_disclosure_id(
    disclose(company_id_param),  // Now a parameter, so disclose() works
    disclose(auditor_id),
    permission_type
  );

  // Generate shared encryption key
  const shared_key = PC_generate_shared_disclosure_key(
    disclose(company_id_param),  // Now a parameter, so disclose() works
    disclose(auditor_id),
    permission_type
  );

  // Calculate expiration timestamp
  const expiration = (disclose(expires_in) == 0 as Uint<32>) ?
    0 as Uint<32> :
    (current_timestamp + disclose(expires_in)) as Uint<32>;

  // Create authorization
  const authorization = PC_DisclosureAuthorization {
    grantor_id: disclose(company_id_param),  // Now a parameter, so disclose() works
    grantee_id: disclose(auditor_id),
    shared_encryption_key: shared_key,
    threshold: 0 as Uint<64>,  // Not used for audit disclosures
    created_at: current_timestamp,
    last_updated: current_timestamp,
    permission_type: permission_type,
    expires_at: expiration
  };

  // Store authorization on public ledger
  disclosure_authorizations.insert(disclosure_id, authorization);
}

// Revoke disclosure authorization
// Allows employee to revoke lender's access to payment history
export circuit revoke_disclosure(
  grantor_id: Bytes<32>,
  grantee_id: Bytes<32>,
  permission_type: Uint<8>
): [] {
  // Generate disclosure ID (disclose permission_type as it's not sensitive)
  const disclosure_id = PC_generate_disclosure_id(
    disclose(grantor_id),
    disclose(grantee_id),
    disclose(permission_type)
  );

  // Verify disclosure exists
  assert(disclosure_authorizations.member(disclosure_id), "Disclosure not found");
  const auth = disclosure_authorizations.lookup(disclosure_id);

  // Verify caller is the grantor (employee who granted access)
  assert(auth.grantor_id == disclose(grantor_id), "Only grantor can revoke");

  // Remove authorization from ledger
  disclosure_authorizations.remove(disclosure_id);

  // Remove shared payment history
  if (shared_payment_history.member(disclosure_id)) {
    shared_payment_history.remove(disclosure_id);
  }
}

// ========================================
// EMPLOYMENT STATUS MANAGEMENT
// ========================================

// Update employee's employment status (company only)
// Allows THIS company to mark employee as active, inactive, terminated, or on leave
// NOTE: Only this contract's company can update status (enforced at API layer)
export circuit update_employment_status(
  employee_id: Bytes<32>,
  new_status: Uint<8>
): [] {
  // Verify employee exists
  assert(employee_accounts.member(disclose(employee_id)), "Employee not found");

  // Generate employment record ID
  const employment_record_id = PC_generate_employment_record_id(
    company_id,  // This contract's company ID
    disclose(employee_id)
  );

  // Verify employment record exists
  assert(employment_records.member(employment_record_id), "Employment record not found");

  // Get existing record
  const existing_record = employment_records.lookup(employment_record_id);

  // Verify record belongs to this company (sanity check)
  assert(existing_record.company_id == company_id, "Employment record mismatch");

  // Update record with new status
  const updated_record = PC_EmploymentRecord {
    company_id: existing_record.company_id,
    employee_id: existing_record.employee_id,
    status: disclose(new_status),
    hire_date: existing_record.hire_date,
    last_updated: current_timestamp
  };

  employment_records.insert(employment_record_id, updated_record);
}

// Verify employment status for disclosure (grantee can check)
// Returns 1 if employee is actively employed at THIS company, 0 otherwise
// NOTE: Verifies employment at this contract's company
export circuit verify_employment(
  employee_id: Bytes<32>,
  verifier_id: Bytes<32>
): Bytes<1> {
  // 1. Check disclosure authorization exists and is valid
  const permission_type = PC_PERMISSION_TYPE_EMPLOYMENT();
  const disclosure_id = PC_generate_disclosure_id(
    disclose(employee_id),
    disclose(verifier_id),
    permission_type
  );

  assert(disclosure_authorizations.member(disclosure_id), "No disclosure permission");
  const auth = disclosure_authorizations.lookup(disclosure_id);

  // Verify caller is the authorized verifier
  assert(auth.grantee_id == disclose(verifier_id), "Not authorized verifier");

  // Check authorization hasn't expired
  assert(
    auth.expires_at == (0 as Uint<32>) || auth.expires_at > current_timestamp,
    "Authorization expired"
  );

  // 2. Get employment record for THIS company
  const employment_record_id = PC_generate_employment_record_id(
    company_id,  // This contract's company ID
    disclose(employee_id)
  );

  // If no employment record exists, return 0 (not employed)
  if (!employment_records.member(employment_record_id)) {
    return pad(1, "\x00");
  }

  const employment_record = employment_records.lookup(employment_record_id);

  // 3. Check if status is ACTIVE
  const is_active = employment_record.status == PC_EMPLOYMENT_STATUS_ACTIVE();

  if (is_active) {
    return pad(1, "\x01");
  } else {
    return pad(1, "\x00");
  }
}

// ========================================
// RECURRING PAYMENTS
// ========================================

// Create recurring payment schedule for automated payroll
// Parameters:
//   employee_id: Employee receiving payments (must be registered)
//   amount: Payment amount (encrypted with employee key)
//   frequency: 0=weekly, 1=bi-weekly, 2=monthly
//   start_date: Unix timestamp when payments begin (>= current_timestamp)
//   end_date: Unix timestamp when payments end (0 = never expires)
// NOTE: Only company can create (enforced at API layer)
export circuit create_recurring_payment(
  employee_id: Bytes<32>,
  amount: Uint<64>,
  frequency: Uint<8>,
  start_date: Uint<32>,
  end_date: Uint<32>,
  next_payment_date: Uint<32>,         // API-calculated first payment date
  payment_day_of_month_1: Uint<8>,     // For monthly: 1-31, biweekly: 1st day, weekly: 0
  payment_day_of_month_2: Uint<8>,     // For biweekly: 2nd day (15), others: 0
  payment_day_of_week: Uint<8>         // For weekly: 0-6 (0=Sunday), others: 0
): [] {
  // Verify employee exists
  assert(employee_accounts.member(disclose(employee_id)), "Employee not found");

  // Verify amount is positive
  assert(disclose(amount) > 0 as Uint<64>, "Amount must be positive");

  // Verify frequency is valid (0=weekly, 1=bi-weekly, 2=monthly)
  assert(
    disclose(frequency) == PC_FREQUENCY_WEEKLY() ||
    disclose(frequency) == PC_FREQUENCY_BIWEEKLY() ||
    disclose(frequency) == PC_FREQUENCY_MONTHLY(),
    "Invalid frequency"
  );

  // Verify start_date is in the future (or current)
  assert(disclose(start_date) >= current_timestamp, "Start date must be in the future");

  // Verify end_date is after start_date (if set)
  if (disclose(end_date) > 0 as Uint<32>) {
    assert(disclose(end_date) > disclose(start_date), "End date must be after start date");
  }

  // Verify next_payment_date is valid
  assert(disclose(next_payment_date) >= disclose(start_date), "Next payment must be >= start date");
  assert(disclose(next_payment_date) <= (current_timestamp + (90 as Uint<32>) * (86400 as Uint<32>)), "Next payment too far in future (max 90 days)");

  // Verify calendar configuration based on frequency
  if (disclose(frequency) == PC_FREQUENCY_MONTHLY()) {
    assert(disclose(payment_day_of_month_1) >= 1 as Uint<8> && disclose(payment_day_of_month_1) <= 31 as Uint<8>, "Monthly payment day must be 1-31");
  }
  if (disclose(frequency) == PC_FREQUENCY_BIWEEKLY()) {
    assert(disclose(payment_day_of_month_1) >= 1 as Uint<8> && disclose(payment_day_of_month_1) <= 31 as Uint<8>, "Biweekly day 1 must be 1-31");
    assert(disclose(payment_day_of_month_2) >= 1 as Uint<8> && disclose(payment_day_of_month_2) <= 31 as Uint<8>, "Biweekly day 2 must be 1-31");
  }
  if (disclose(frequency) == PC_FREQUENCY_WEEKLY()) {
    assert(disclose(payment_day_of_week) <= 6 as Uint<8>, "Weekly payment day must be 0-6 (0=Sunday)");
  }

  // Generate employee encryption key
  const employee_key = generate_balance_key(employee_id);

  // Encrypt payment amount with employee key (for privacy)
  const encrypted_amount = encrypt_balance(disclose(amount), employee_key);

  // Add encrypted amount to value_decryption_map for later decryption in process_recurring_payment
  value_decryption_map.insert(encrypted_amount, disclose(amount));

  // Generate unique recurring payment ID
  const recurring_payment_id = PC_generate_recurring_payment_id(
    company_id,
    disclose(employee_id),
    current_timestamp
  );

  // Create recurring payment record with calendar configuration
  const recurring_payment = PC_RecurringPayment {
    recurring_payment_id: recurring_payment_id,
    company_id: company_id,
    employee_id: disclose(employee_id),
    encrypted_amount: encrypted_amount,
    frequency: disclose(frequency),
    start_date: disclose(start_date),
    end_date: disclose(end_date),
    next_payment_date: disclose(next_payment_date),
    payment_day_of_month_1: disclose(payment_day_of_month_1),
    payment_day_of_month_2: disclose(payment_day_of_month_2),
    payment_day_of_week: disclose(payment_day_of_week),
    status: PC_RECURRING_STATUS_ACTIVE(),
    created_at: current_timestamp,
    last_updated: current_timestamp
  };

  // Store in recurring_payments map
  recurring_payments.insert(recurring_payment_id, recurring_payment);

  // Also store employee_id -> recurring_payment_id mapping for easy lookup
  recurring_payment_by_employee.insert(disclose(employee_id), recurring_payment_id);
}

// Pause a recurring payment (company can pause to temporarily stop payments)
export circuit pause_recurring_payment(recurring_payment_id: Bytes<32>): [] {
  // Verify recurring payment exists
  assert(recurring_payments.member(disclose(recurring_payment_id)), "Recurring payment not found");

  // Get the payment
  const payment = recurring_payments.lookup(disclose(recurring_payment_id));

  // Verify payment is currently ACTIVE
  assert(payment.status == PC_RECURRING_STATUS_ACTIVE(), "Payment must be ACTIVE to pause");

  // Update payment with PAUSED status
  const updated_payment = PC_RecurringPayment {
    recurring_payment_id: payment.recurring_payment_id,
    company_id: payment.company_id,
    employee_id: payment.employee_id,
    encrypted_amount: payment.encrypted_amount,
    frequency: payment.frequency,
    start_date: payment.start_date,
    end_date: payment.end_date,
    next_payment_date: payment.next_payment_date,
    payment_day_of_month_1: payment.payment_day_of_month_1,
    payment_day_of_month_2: payment.payment_day_of_month_2,
    payment_day_of_week: payment.payment_day_of_week,
    status: PC_RECURRING_STATUS_PAUSED(),
    created_at: payment.created_at,
    last_updated: current_timestamp
  };

  // Update in map
  recurring_payments.insert(disclose(recurring_payment_id), updated_payment);
}

// Resume a paused recurring payment
// API calculates next_payment_date using JavaScript Date libraries for calendar accuracy
export circuit resume_recurring_payment(
  recurring_payment_id: Bytes<32>,
  next_payment_date: Uint<32>  // API-calculated next payment date
): [] {
  // Verify recurring payment exists
  assert(recurring_payments.member(disclose(recurring_payment_id)), "Recurring payment not found");

  // Get the payment
  const payment = recurring_payments.lookup(disclose(recurring_payment_id));

  // Verify payment is currently PAUSED
  assert(payment.status == PC_RECURRING_STATUS_PAUSED(), "Payment must be PAUSED to resume");

  // Validate API-provided next_payment_date
  assert(disclose(next_payment_date) >= current_timestamp, "Next payment date must be in future");
  assert(disclose(next_payment_date) <= (current_timestamp + (90 as Uint<32>) * (86400 as Uint<32>)), "Next payment date too far in future (max 90 days)");

  // Update payment with ACTIVE status and API-calculated next_payment_date
  const updated_payment = PC_RecurringPayment {
    recurring_payment_id: payment.recurring_payment_id,
    company_id: payment.company_id,
    employee_id: payment.employee_id,
    encrypted_amount: payment.encrypted_amount,
    frequency: payment.frequency,
    start_date: payment.start_date,
    end_date: payment.end_date,
    next_payment_date: disclose(next_payment_date),
    payment_day_of_month_1: payment.payment_day_of_month_1,
    payment_day_of_month_2: payment.payment_day_of_month_2,
    payment_day_of_week: payment.payment_day_of_week,
    status: PC_RECURRING_STATUS_ACTIVE(),
    created_at: payment.created_at,
    last_updated: current_timestamp
  };

  // Update in map
  recurring_payments.insert(disclose(recurring_payment_id), updated_payment);
}

// Edit recurring payment amount
export circuit edit_recurring_payment(
  recurring_payment_id: Bytes<32>,
  new_amount: Uint<64>
): [] {
  // Load existing recurring payment
  assert(recurring_payments.member(disclose(recurring_payment_id)), "Recurring payment not found");
  const payment = recurring_payments.lookup(disclose(recurring_payment_id));

  // Verify status is ACTIVE or PAUSED (cannot edit CANCELLED)
  assert(
    disclose(payment.status) == PC_RECURRING_STATUS_ACTIVE() ||
    disclose(payment.status) == PC_RECURRING_STATUS_PAUSED(),
    "Cannot edit cancelled recurring payment"
  );

  // Verify new amount is valid
  assert(disclose(new_amount) > (0 as Uint<64>), "Amount must be greater than 0");

  // Encrypt new amount with employee key
  const employee_key = generate_balance_key(payment.employee_id);
  const new_encrypted_amount = encrypt_balance(disclose(new_amount), employee_key);

  // Add new encrypted amount to value_decryption_map for later decryption
  value_decryption_map.insert(new_encrypted_amount, disclose(new_amount));

  // Update payment record
  const updated_payment = PC_RecurringPayment {
    recurring_payment_id: payment.recurring_payment_id,
    company_id: payment.company_id,
    employee_id: payment.employee_id,
    encrypted_amount: new_encrypted_amount,  // Updated amount
    frequency: payment.frequency,
    start_date: payment.start_date,
    end_date: payment.end_date,
    next_payment_date: payment.next_payment_date,
    payment_day_of_month_1: payment.payment_day_of_month_1,
    payment_day_of_month_2: payment.payment_day_of_month_2,
    payment_day_of_week: payment.payment_day_of_week,
    status: payment.status,
    created_at: payment.created_at,
    last_updated: current_timestamp  // Updated timestamp
  };

  recurring_payments.insert(disclose(recurring_payment_id), updated_payment);
}

// Process recurring payment (manual trigger)
export circuit process_recurring_payment(
  recurring_payment_id: Bytes<32>
): [] {
  // Load recurring payment
  assert(recurring_payments.member(disclose(recurring_payment_id)), "Recurring payment not found");
  const payment = recurring_payments.lookup(disclose(recurring_payment_id));

  // Verify status is ACTIVE
  assert(
    disclose(payment.status) == PC_RECURRING_STATUS_ACTIVE(),
    "Recurring payment is not active"
  );

  // Verify payment is due (current_timestamp >= next_payment_date)
  assert(
    current_timestamp >= disclose(payment.next_payment_date),
    "Payment not due yet"
  );

  // Decrypt payment amount (lookup in value_decryption_map)
  const payment_amount = value_decryption_map.lookup(payment.encrypted_amount);

  // Execute payment (inline pay_employee logic)
  // 1. Calculate available budget (total_supply - allocated_to_employees)
  assert(total_supply >= allocated_to_employees, "Accounting error: allocated exceeds supply");
  const available_budget = (total_supply - allocated_to_employees) as Uint<64>;

  // 2. Verify company has sufficient available budget
  assert(available_budget >= payment_amount, "Insufficient available budget");

  // 3. Allocate funds to employee
  allocated_to_employees = (allocated_to_employees + payment_amount) as Uint<64>;

  // 4. Generate encryption key for employee
  const employee_key = generate_balance_key(payment.employee_id);

  // 5. Decrypt employee balance (or create if new)
  const employee_encrypted = encrypted_employee_balances.member(payment.employee_id) ?
    encrypted_employee_balances.lookup(payment.employee_id) : encrypt_balance(0 as Uint<64>, employee_key);
  const employee_balance = value_decryption_map.member(employee_encrypted) ?
    value_decryption_map.lookup(employee_encrypted) : 0 as Uint<64>;

  // 6. Add payment to employee balance
  const new_employee_balance = (employee_balance + payment_amount) as Uint<64>;

  // 7. Re-encrypt employee balance
  const new_employee_hash = encrypt_balance(new_employee_balance, employee_key);

  // 8. Update encrypted employee balance on ledger
  encrypted_employee_balances.insert(payment.employee_id, new_employee_hash);

  // 9. Update balance mapping for decryption
  value_decryption_map.insert(new_employee_hash, new_employee_balance);

  // 10. Encrypt payment amount with employee's key (for payment history)
  const encrypted_payment_amount = encrypt_balance(payment_amount, employee_key);
  value_decryption_map.insert(encrypted_payment_amount, payment_amount);

  // 11. Generate unique payment ID (for cancellation tracking)
  const payment_id = PC_generate_payment_id(payment.company_id, payment.employee_id, current_timestamp);

  // 12. Record payment in history
  const payment_record = PC_create_payment_record(
    payment_id,
    current_timestamp,
    encrypted_payment_amount,  // Use encrypted amount for privacy
    payment.company_id,
    PC_PAYMENT_TYPE_SALARY(),
    PC_PAYMENT_STATUS_COMPLETED()  // Payment successful
  );

  const current_history = employee_payment_history.lookup(payment.employee_id);
  const updated_history = PC_append_to_history(current_history, payment_record);
  employee_payment_history.insert(payment.employee_id, updated_history);

  // 12. Increment payment counter
  total_payments.increment(1);

  // 13. Calculate next payment date
  const next_date = PC_calculate_next_payment_date(
    disclose(payment.next_payment_date),
    payment.frequency
  );

  // 12. Check if recurring payment should be cancelled (past end_date)
  const should_cancel = (
    disclose(payment.end_date) > (0 as Uint<32>) &&
    next_date > disclose(payment.end_date)
  );
  const new_status = should_cancel ? PC_RECURRING_STATUS_CANCELLED() : payment.status;

  // 13. Update recurring payment record
  const updated_payment = PC_RecurringPayment {
    recurring_payment_id: payment.recurring_payment_id,
    company_id: payment.company_id,
    employee_id: payment.employee_id,
    encrypted_amount: payment.encrypted_amount,
    frequency: payment.frequency,
    start_date: payment.start_date,
    end_date: payment.end_date,
    next_payment_date: next_date,  // Updated to next occurrence
    payment_day_of_month_1: payment.payment_day_of_month_1,
    payment_day_of_month_2: payment.payment_day_of_month_2,
    payment_day_of_week: payment.payment_day_of_week,
    status: new_status,  // May be cancelled if past end_date
    created_at: payment.created_at,
    last_updated: current_timestamp  // Updated timestamp
  };

  recurring_payments.insert(disclose(recurring_payment_id), updated_payment);
}


/**
 * Register Trusted Verifier
 *
 * Allows contract owner (company) to register a trusted ZKML verifier.
 * In production, this would be restricted to contract deployer or governance.
 *
 * @param verifier_pubkey Public key of the trusted verifier
 */
export circuit register_trusted_verifier(verifier_pubkey: Bytes<32>): Boolean {
  // TODO: Add access control (only contract owner/governance)
  // For now, anyone can register a verifier (MVP simplification)

  // Check if verifier is already registered
  if (trusted_verifiers.member(disclose(verifier_pubkey))) {
    return false; // Already registered
  }

  trusted_verifiers.insert(disclose(verifier_pubkey), 1 as Uint<1>);
  return true; // Successfully registered
}


// ========================================
// SECTION 2.1: SALARY HISTORY PROOFS
// ========================================

// Submit Income Proof (ZKML Circuit)
// Employee submits ZKML proof to demonstrate income eligibility
// Proof types: 1=INCOME_ABOVE_THRESHOLD, 2=INCOME_RANGE, 3=AVERAGE_INCOME, 4=CREDIT_SCORE
export circuit submit_income_proof(
  employee_id: Bytes<32>,
  proof_type: Uint<8>,
  threshold_min: Uint<64>,
  threshold_max: Uint<64>,
  txids: Vector<12, Bytes<32>>,
  merkle_root: Bytes<32>,
  attestation_hash: Bytes<32>,
  verifier_pubkey: Bytes<32>,
  timestamp: Uint<64>,
  expires_in: Uint<32>  // Seconds until expiry (e.g., 2592000 for 30 days)
): Boolean {
  // Step 1: Verify proof type is valid (1-4)
  if (disclose(proof_type) < (1 as Uint<8>) || disclose(proof_type) > (4 as Uint<8>)) {
    return false; // Invalid proof type
  }

  // Step 2: Verify verifier is trusted
  if (!trusted_verifiers.member(disclose(verifier_pubkey))) {
    return false; // Verifier not trusted
  }

  // Step 3: Prevent replay attacks - check attestation hash hasn't been used
  if (used_attestations.member(disclose(attestation_hash))) {
    return false; // Attestation already used
  }
  used_attestations.insert(disclose(attestation_hash), 1 as Uint<1>);

  // Step 4: Verify timestamp is fresh (within 1 hour)
  const current_time = current_timestamp as Uint<64>;
  const one_hour_ago = (current_time - (3600 as Uint<64>)) as Uint<64>;
  if (disclose(timestamp) <= one_hour_ago) {
    return false; // Proof timestamp too old
  }
  if (disclose(timestamp) > current_time) {
    return false; // Proof timestamp is in the future
  }

  // Step 5: Validate threshold values based on proof type
  // For INCOME_RANGE (type 2), threshold_max must be > threshold_min
  if (disclose(proof_type) == (2 as Uint<8>)) {
    if (disclose(threshold_max) <= disclose(threshold_min)) {
      return false; // Invalid range
    }
  }

  // Step 6: Calculate expiration time
  const expiration_time = (current_timestamp + disclose(expires_in)) as Uint<32>;

  // Step 7: Store income proof in ledger
  const income_proof = PC_IncomeProof {
    employee_id: disclose(employee_id),
    proof_type: disclose(proof_type),
    threshold_min: disclose(threshold_min),
    threshold_max: disclose(threshold_max),
    txids: disclose(txids),
    merkle_root: disclose(merkle_root),
    attestation_hash: disclose(attestation_hash),
    verifier_pubkey: disclose(verifier_pubkey),
    submitted_at: current_timestamp,
    expires_at: expiration_time
  };

  income_proofs.insert(disclose(employee_id), income_proof);

  // Success: Income proof stored and available for verification
  return true;
}

// Verify Income Proof (ZKML Verification Circuit)
// Lender/landlord verifies employee's income proof meets their requirements
// Returns true if proof exists and meets requirements, false otherwise
export circuit verify_income_proof(
  employee_id: Bytes<32>,
  required_proof_type: Uint<8>,
  required_threshold: Uint<64>
): Boolean {
  // Step 1: Check if employee has submitted an income proof
  if (!income_proofs.member(disclose(employee_id))) {
    return false;
  }

  // Step 2: Retrieve the income proof
  const proof = income_proofs.lookup(disclose(employee_id));

  // Step 3: Verify proof type matches requirement
  if (disclose(proof.proof_type) != disclose(required_proof_type)) {
    return false;
  }

  // Step 4: Verify proof hasn't expired
  const current_time = current_timestamp;
  if (disclose(proof.expires_at) != (0 as Uint<32>) && disclose(proof.expires_at) <= current_time) {
    return false; // expired
  }

  // Step 5: Verify threshold based on proof type
  if (disclose(required_proof_type) == (1 as Uint<8>)) {
    // INCOME_ABOVE_THRESHOLD: Check threshold_min >= required_threshold
    if (disclose(proof.threshold_min) < disclose(required_threshold)) {
      return false;
    }
  } else if (disclose(required_proof_type) == (2 as Uint<8>)) {
    // INCOME_RANGE: Check required_threshold is within range
    if (disclose(required_threshold) < disclose(proof.threshold_min) ||
        disclose(required_threshold) > disclose(proof.threshold_max)) {
      return false;
    }
  } else if (disclose(required_proof_type) == (3 as Uint<8>)) {
    // AVERAGE_INCOME: Check threshold_min >= required_threshold
    if (disclose(proof.threshold_min) < disclose(required_threshold)) {
      return false;
    }
  } else if (disclose(required_proof_type) == (4 as Uint<8>)) {
    // CREDIT_SCORE: Check threshold_min >= required_threshold
    if (disclose(proof.threshold_min) < disclose(required_threshold)) {
      return false;
    }
  }

  // Success: Income proof verified and meets requirements
  return true;
}

// ========================================
// UTILITY FUNCTIONS
// ========================================

export circuit update_timestamp(new_timestamp: Uint<32>): [] {
  assert(new_timestamp > current_timestamp, "Timestamp must be in the future");
  current_timestamp = disclose(new_timestamp);
}
