# Server Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# EZKL Model Paths (relative to zkml-verifier directory)
VK_PATH=../zkml/examples/01-simple-threshold/vk.key
SETTINGS_PATH=../zkml/examples/01-simple-threshold/settings.json

# Verifier Secret Key (plain string)
# This secret is used to create attestation commitments
# IMPORTANT: Keep this secret secure - never expose it to clients!
# For testing, use the same secret as E2E tests to ensure compatibility
VERIFIER_SECRET_KEY=test-verifier-secret-12345

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
