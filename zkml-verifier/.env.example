# Server Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# EZKL Model Paths (relative to zkml-verifier directory)
VK_PATH=../zkml/examples/01-simple-threshold/vk.key
SETTINGS_PATH=../zkml/examples/01-simple-threshold/settings.json

# Verifier Secret Key (Midnight Authentication Pattern)
# This secret is used to prove verifier identity when calling smart contract circuits
# The public key is derived as: hash("zksalaria:verifier:pk:" + secret)
#
# SECURITY: This secret proves ownership of the registered verifier public key
#           Only entities with this secret can submit attestations to the contract
#           NEVER expose this to clients or commit real secrets to git!
#
# Usage: The verifier service loads this secret and uses it to prove ownership
#        when calling submitIncomeProof() via the Payroll API
#
# For testing, use the same secret as E2E tests to ensure compatibility
VERIFIER_SECRET_KEY=test-verifier-secret-12345

# Contract Configuration
# The deployed payroll contract address that this verifier will submit proofs to
CONTRACT_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
