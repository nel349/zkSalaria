# zkml-verifier Environment Configuration

# Server Configuration
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# EZKL Configuration (Proof Generation)
VK_PATH=../zkml/examples/01-simple-threshold/vk.key
SETTINGS_PATH=../zkml/examples/01-simple-threshold/settings.json
EZKL_PATH=/path/to/ezkl

# Verifier Identity (for witness-based authentication)
VERIFIER_SECRET_KEY=your_verifier_secret_key_here

# Blockchain Submission (Optional)
# Set to "true" to enable automatic proof submission to blockchain
# When enabled, the verifier service will submit proofs directly to the contract
# Requires Midnight network configuration (below)
ENABLE_BLOCKCHAIN_SUBMISSION=false

# Midnight Network Configuration (Required only if ENABLE_BLOCKCHAIN_SUBMISSION=true)
# These are automatically used by PayrollAPI when initializing providers
MIDNIGHT_INDEXER=http://127.0.0.1:8088/api/v1/graphql
MIDNIGHT_INDEXER_WS=ws://127.0.0.1:8088/api/v1/graphql/ws
MIDNIGHT_NODE=http://127.0.0.1:9944
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# ZK Config Path (Required only if ENABLE_BLOCKCHAIN_SUBMISSION=true)
ZK_CONFIG_PATH=../payroll-contract/managed/payroll

# Notes:
# - The verifier always generates ZK proofs and creates attestations
# - If ENABLE_BLOCKCHAIN_SUBMISSION=false, the verifier returns the attestation to the caller
# - If ENABLE_BLOCKCHAIN_SUBMISSION=true, the verifier submits the proof to the blockchain automatically
#   and the caller just receives confirmation
